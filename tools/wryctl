#!/usr/bin/env python3
"""wryctl: run wry commands over its control socket.

    wryctl [--socket PATH] COMMAND [ARGUMENT...]
    wryctl [--socket PATH] -

The first form joins its arguments with spaces into one command line, runs
it, and prints the reply (exit status 1 if it failed or was cancelled):

    wryctl help
    wryctl step 10
    wryctl write 'Coordinate(3, 4)' OPCODE::SWAP
    wryctl type '"hello\\n"'

The second form reads command lines from stdin and runs them in order,
waiting for each reply before sending the next.

The game must be running with its control socket open:

    open client.app --args --control-socket

The socket is $WRY_CONTROL_SOCKET if set, else $TMPDIR/wry-control.sock,
the game's default.  Protocol and command language:
client/client/core/docs/commands.md.
"""

import json
import os
import socket
import sys
import tempfile


def default_socket_path():
    return (os.environ.get("WRY_CONTROL_SOCKET")
            or os.path.join(tempfile.gettempdir(), "wry-control.sock"))


class Connection:
    """One connection: requests are answered in order, one reply line each."""

    def __init__(self, path):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(path)
        self.buffer = b""
        self.next_id = 1

    def request(self, payload):
        payload = dict(payload, id=self.next_id)
        self.next_id += 1
        self.sock.sendall(json.dumps(payload).encode("utf-8") + b"\n")
        while b"\n" not in self.buffer:
            chunk = self.sock.recv(65536)
            if not chunk:
                raise ConnectionError("the game closed the control socket")
            self.buffer += chunk
        line, self.buffer = self.buffer.split(b"\n", 1)
        return json.loads(line)

    def run(self, line):
        return self.request({"line": line})


def show(reply):
    if reply.get("text"):
        print(reply["text"])
    status = reply.get("status")
    if status != "ok":
        print(f"({status})", file=sys.stderr)
        return False
    return True


def main(argv):
    path = default_socket_path()
    if len(argv) >= 2 and argv[0] == "--socket":
        path, argv = argv[1], argv[2:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv else 2
    try:
        connection = Connection(path)
    except OSError as e:
        print(f"wryctl: cannot connect to {path}: {e.strerror or e}", file=sys.stderr)
        return 2
    if argv == ["-"]:
        ok = True
        for line in sys.stdin:
            line = line.rstrip("\n")
            if line.strip():
                ok = show(connection.run(line)) and ok
        return 0 if ok else 1
    return 0 if show(connection.run(" ".join(argv))) else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
